# Every text file stays LF in the index and in the checkout, on every platform. Several tests
# compare exported bytes directly, so a CRLF checkout would fail them for no real reason.
* text=auto eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.jar binary

# Alembic writes its revisions from a template and the default heuristics can
# read templated files as generated. They are linted, typed and tested like
# everything else here, so say so rather than letting a guess decide.
migrations/** linguist-generated=false
